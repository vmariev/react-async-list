{
  "name": "@kinavi/react-async-list",
  "version": "2.0.0",
  "description": "Zero-dependency bidirectional infinite-scroll list for React, with reverse (chat) mode and an optional custom scrollbar.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "prepublishOnly": "npm run typecheck && npm run build",
    "prebuild": "node scripts/build-css.mjs",
    "predev": "node scripts/build-css.mjs",
    "pretypecheck": "node scripts/build-css.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "keywords": [
    "react",
    "infinite-scroll",
    "lazy-load",
    "lazy-loading",
    "list",
    "chat",
    "reverse",
    "bidirectional",
    "scrollbar",
    "pagination"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinavi/react-async-list.git"
  },
  "author": "kinavi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kinavi/react-async-list/issues"
  },
  "homepage": "https://github.com/kinavi/react-async-list#readme",
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@tanstack/react-virtual": "^3.14.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.9",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
